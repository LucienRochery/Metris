@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Boost's find_package overwrites everything instead of appending, so we have to do it manually.
set(SAVE_BOOST_LIBRARIES ${Boost_LIBRARIES})
set(SAVE_BOOST_INCLUDE_DIRS ${Boost_INCLUDE_DIRS})
# Dependencies are registered in Dependencies.cmake depending on how they were obtained (FetchContent or find_package)
@METRIS_DEPS_EXPORT_CODE@
list(APPEND Boost_LIBRARIES ${SAVE_BOOST_LIBRARIES})
list(APPEND Boost_INCLUDE_DIRS ${SAVE_BOOST_INCLUDE_DIRS})

include("${CMAKE_CURRENT_LIST_DIR}/libMetrisTargets.cmake")
check_required_components(Metris)
